rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function activeUser() { return signedIn() && userDoc().data.active == true; }
    function role() { return userDoc().data.role; }
    function isDirector() { return activeUser() && role() == 'director'; }
    function isWarehouse() { return activeUser() && role() == 'warehouse'; }
    function isManager() { return activeUser() && role() in ['manager', 'chief_accountant', 'accountant']; }
    // Бухгалтеры и главный бухгалтер входят в ту же группу полномочий, что и менеджеры.
    function hasManagerPermissions() { return isManager(); }
    function canManageUsers() { return activeUser() && (userDoc().data.admin == true || role() == 'director'); }
    function canViewDeletedOrders() { return activeUser() && (userDoc().data.admin == true || role() in ['director', 'chief_accountant']); }
    function chatLikes(data) { return data.keys().hasAll(['likes']) ? data.likes : []; }
    function chatReadBy(data) { return data.keys().hasAll(['readBy']) ? data.readBy : []; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canManageUsers());
      allow create: if canManageUsers()
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'active', 'admin'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.active == true
        && request.resource.data.admin == (request.resource.data.role == 'director')
        && request.resource.data.role in ['warehouse', 'manager', 'chief_accountant', 'accountant', 'director'];
      allow update: if (activeUser() && request.auth.uid == userId
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationSettings'])
            && request.resource.data.notificationSettings is map
            && request.resource.data.notificationSettings.keys().hasOnly(['chat', 'replies', 'likes', 'orders'])
            && request.resource.data.notificationSettings.chat is bool
            && request.resource.data.notificationSettings.replies is bool
            && request.resource.data.notificationSettings.likes is bool
            && request.resource.data.notificationSettings.orders is bool)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extraPhoneNotifications'])
            && request.resource.data.extraPhoneNotifications is bool)
        ))
        || isDirector()
        || (canManageUsers() && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'role', 'active', 'admin'])
          && request.resource.data.admin == (request.resource.data.role == 'director')
          && request.resource.data.role in ['warehouse', 'manager', 'chief_accountant', 'accountant', 'director']);
      allow delete: if isDirector();


      match /notifications/{notificationId} {
        allow read: if activeUser() && request.auth.uid == userId;
        allow update: if activeUser()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool
          && request.resource.data.read == true;
        allow create, delete: if false;
      }

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if activeUser() && request.auth.uid == userId;
      }
    }

    match /chatMessages/{messageId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'authorRole', 'createdAt', 'photos', 'likes', 'readBy', 'replyToId', 'replyToAuthorId', 'replyToAuthorName', 'replyToText'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorRole == role()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string)
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 5
        && request.resource.data.likes is list
        && request.resource.data.likes.size() <= 200
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() <= 200
        && request.resource.data.readBy.hasAll([request.resource.data.authorId])
        && (!request.resource.data.keys().hasAny(['replyToId', 'replyToAuthorId', 'replyToAuthorName', 'replyToText'])
          || (request.resource.data.replyToId is string
            && request.resource.data.replyToAuthorId is string
            && request.resource.data.replyToAuthorName is string
            && request.resource.data.replyToText is string
            && get(/databases/$(database)/documents/chatMessages/$(request.resource.data.replyToId)).data.authorId == request.resource.data.replyToAuthorId))
        && (request.resource.data.text.size() > 0 || request.resource.data.photos.size() > 0);
      // Read receipts and likes are validated independently so malformed legacy
      // fields cannot block an unrelated update.
      allow update: if activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() <= 500
        && request.resource.data.readBy.hasAll([request.auth.uid])
        && (
          // Preserve existing receipts when the legacy value is a valid list.
          !(resource.data.keys().hasAny(['readBy']) && resource.data.readBy is list)
          ||
          (
            request.resource.data.readBy.hasAll(resource.data.readBy)
            && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1
          )
        )
        ||
        (activeUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is list
          && request.resource.data.likes.size() <= 200
          && (
            (request.resource.data.likes.hasOnly(chatLikes(resource.data).concat([request.auth.uid]))
              && request.resource.data.likes.size() == chatLikes(resource.data).size() + 1)
            ||
            (chatLikes(resource.data).hasOnly(request.resource.data.likes.concat([request.auth.uid]))
              && request.resource.data.likes.size() == chatLikes(resource.data).size() - 1)
          ));
      allow delete: if false;
    }

    match /pushQueue/{eventId} {
      // Client-created notification requests are bounded and limited to active recipients.
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['title', 'body', 'authorId', 'orderId', 'target', 'category', 'recipientUserId', 'createdAt', 'sentAt', 'isMention', 'isReply'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 500
        && request.resource.data.sentAt == null
        && (!request.resource.data.keys().hasAny(['isMention']) || request.resource.data.isMention is bool)
        && (!request.resource.data.keys().hasAny(['isReply']) || request.resource.data.isReply is bool)
        && request.resource.data.target in ['site', 'chat']
        && request.resource.data.category in ['orders', 'chat', 'replies', 'likes']
        && request.resource.data.recipientUserId is string
        && request.resource.data.recipientUserId.size() <= 128
        && (request.resource.data.recipientUserId == ''
          || get(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)).data.active == true)
        && (
          (request.resource.data.category == 'orders'
            && request.resource.data.target == 'site'
            && request.resource.data.orderId is string
            && request.resource.data.orderId.size() > 0
            && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
            && request.resource.data.recipientUserId == '')
          ||
          (request.resource.data.category == 'chat'
            && request.resource.data.target == 'chat'
            && request.resource.data.recipientUserId == '')
          ||
          (request.resource.data.category == 'replies'
            && request.resource.data.recipientUserId.size() > 0)
          ||
          (request.resource.data.category == 'likes'
            && request.resource.data.target == 'chat'
            && request.resource.data.recipientUserId.size() > 0)
        )
        && (!request.resource.data.keys().hasAny(['orderId']) || request.resource.data.orderId is string)
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is string
          || request.resource.data.createdAt is timestamp);
      allow read, update, delete: if false;
    }

    match /deletedOrders/{archiveId} {
      allow read: if canViewDeletedOrders();
      allow create: if canManageUsers()
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.complete == false;
      allow update: if canManageUsers()
        && resource.data.complete == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete'])
        && request.resource.data.complete == true;
      allow delete: if false;

      match /entries/{entryId} {
        allow read: if canViewDeletedOrders();
        allow create, update: if canManageUsers()
          && get(/databases/$(database)/documents/deletedOrders/$(archiveId)).data.complete == false;
        allow delete: if false;
      }
    }

    match /pendingStaff/{email} {
      allow read: if canManageUsers();
      allow write: if false;
    }

    match /clients/{clientId} {
      allow read: if activeUser();
      // Supports both legacy email records and the current address field,
      // plus metadata used for importing historical clients from orders.
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['name','phone','email','address','comment','createdAt','createdBy','updatedAt','updatedBy','source','historyCount','hiddenFromDirectory'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.keys().hasAny(['source']) || request.resource.data.source in ['order-history','excel','manual'])
        && (!request.resource.data.keys().hasAny(['historyCount']) || request.resource.data.historyCount is number);
      allow update: if activeUser()
        && (
          // Any active user may hide a client from the directory without changing
          // its identity or historical order references.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFromDirectory','updatedAt','updatedBy'])
            && request.resource.data.hiddenFromDirectory == true)
          ||
          (request.resource.data.keys().hasOnly(['name','phone','email','address','comment','createdAt','createdBy','updatedAt','updatedBy','source','historyCount','hiddenFromDirectory'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.updatedBy == request.auth.uid
            && (!request.resource.data.keys().hasAny(['source']) || request.resource.data.source in ['order-history','excel','manual'])
            && (!request.resource.data.keys().hasAny(['historyCount']) || request.resource.data.historyCount is number))
        );
      // Physical deletion remains restricted to management roles.
      allow delete: if isManager() || canManageUsers();
    }

    match /products/{productId} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && (
          (productId == 'meta'
            && request.resource.data.keys().hasOnly(['count','updatedAt','updatedBy'])
            && request.resource.data.count is number
            && request.resource.data.updatedAt is string
            && request.resource.data.updatedBy == request.auth.uid)
          ||
          (productId != 'meta'
            && request.resource.data.keys().hasOnly(['items','count','updatedAt','updatedBy'])
            && request.resource.data.items is list
            && request.resource.data.count is number
            && request.resource.data.updatedAt is string
            && request.resource.data.updatedBy == request.auth.uid)
        );
      allow delete: if canManageUsers();
    }

    match /orders/{orderId} {
      allow read: if activeUser();

      allow create: if (isWarehouse() || isManager() || canManageUsers())
        && request.resource.data.keys().hasOnly([
          'number', 'client', 'deliveryType', 'status', 'articles', 'createdAt', 'createdBy',
          'createdByName', 'updatedAt', 'transferredAt', 'resumedAt',
          'assembledAt', 'shippedAt', 'assemblyInProgress', 'assemblyStartedAt',
          'assemblyStartedBy', 'assemblyStartedByName', 'returns'
        ])
        && request.resource.data.number is string
        && request.resource.data.number.size() > 0
        && request.resource.data.client is string
        && request.resource.data.deliveryType in ['city', 'pickup', 'post']
        && request.resource.data.articles is list
        && request.resource.data.articles.size() <= 100
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in [
          'Создан', 'Собран', 'Отгружен кладовщиком', 'Под вопросом', 'Дефект',
          'Ожидает оплаты', 'На согласовании', 'Одобрен на отгрузку клиенту',
          'Ожидает самовывоза', 'Клиент забрал самовывозом', 'Самовывоз',
          'Перенесен', 'Отменён'
        ];

      // Администратор и директор могут управлять заказом полностью.
      allow update: if ((canManageUsers() || (isWarehouse()
        && (!('returnCancelled' in resource.data) || resource.data.returnCancelled != true)
        && (!('returnCancelled' in request.resource.data) || request.resource.data.returnCancelled != true)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returns', 'returnCancelled', 'status', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.returns is list
        && request.resource.data.returns.size() <= 500
        && request.resource.data.status in ['Возврат', resource.data.status]
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName is string)

        || canManageUsers()

        // Менеджерская группа: после отгрузки редактирование полностью запрещено.
        // Любая активная роль может исправить только номер и имя клиента до отгрузки.
        // Статус, состав заказа и остальные поля этой веткой менять нельзя.
        || (activeUser()
          && resource.data.status != 'Отгружен кладовщиком'
          && resource.data.status != 'Клиент забрал самовывозом'
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['number', 'client', 'updatedAt', 'updatedBy', 'updatedByName'])
          && request.resource.data.number is string
          && request.resource.data.number.size() > 0
          && request.resource.data.client is string
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedByName is string)

        // Все активные сотрудники могут менять состав заказа до отгрузки.
        // Это соответствует интерфейсу: редактирование артикулов доступно всем ролям,
        // но не позволяет этой веткой менять статус, клиента или другие поля заказа.
        || (activeUser()
          && resource.data.status != 'Отгружен кладовщиком'
          && resource.data.status != 'Клиент забрал самовывозом'
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['articles', 'updatedAt', 'updatedBy', 'updatedByName'])
          && request.resource.data.articles is list
          && request.resource.data.articles.size() <= 100
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedByName is string)

        || (isManager()
          && resource.data.status != 'Отгружен кладовщиком'
          && resource.data.status != 'Клиент забрал самовывозом'
          && request.resource.data.status != 'Отгружен кладовщиком'
          && request.resource.data.status != 'Клиент забрал самовывозом'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['number', 'client', 'deliveryType', 'articles', 'status', 'updatedAt', 'updatedBy', 'updatedByName',
              'transferredAt', 'resumedAt', 'assembledAt'])
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedByName is string
          && (!request.resource.data.keys().hasAny(['deliveryType']) || request.resource.data.deliveryType in ['city', 'pickup', 'post'])
          && (request.resource.data.status == resource.data.status
            || request.resource.data.status in [
              'Создан', 'Под вопросом', 'Дефект', 'Ожидает оплаты', 'На согласовании',
              'Одобрен на отгрузку клиенту', 'Ожидает самовывоза',
              'Клиент забрал самовывозом', 'Перенесен', 'Отменён'
            ]))

        // Кладовщик может менять состав/статус до момента отгрузки.
        || (isWarehouse()
          && resource.data.status != 'Отгружен кладовщиком'
          && resource.data.status != 'Клиент забрал самовывозом'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'articles', 'deliveryType', 'updatedAt', 'updatedBy', 'updatedByName',
              'transferredAt', 'resumedAt', 'assembledAt', 'shippedAt', 'assemblyInProgress',
              'assemblyStartedAt', 'assemblyStartedBy', 'assemblyStartedByName']))
        || (isWarehouse()
          && resource.data.status != 'Отгружен кладовщиком'
          && resource.data.status != 'Клиент забрал самовывозом'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'assemblyInProgress', 'assemblyStartedAt', 'assemblyStartedBy', 'assemblyStartedByName',
            'updatedAt', 'updatedBy', 'updatedByName'
          ])
          && request.resource.data.assemblyInProgress is bool
          && request.resource.data.assemblyStartedAt is string
          && request.resource.data.assemblyStartedBy is string
          && request.resource.data.assemblyStartedByName is string
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedByName is string);

      allow delete: if canManageUsers();

      match /entries/{entryId} {
        allow read: if activeUser();

        allow create: if activeUser()
          && request.resource.data.keys().hasOnly([
            'kind', 'article', 'text', 'important', 'authorId', 'authorName', 'createdAt',
            'photos', 'decision', 'decisionText', 'decidedBy',
            'decidedByName', 'decidedAt', 'articleIndex',
            'replyToEntryId', 'replyToAuthorId', 'replyToAuthorName', 'replyToText'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.kind in [
            'comment', 'question', 'defect', 'decision', 'viewed', 'system', 'return'
          ]
          && request.resource.data.text is string
          && (!request.resource.data.keys().hasAny(['important']) || request.resource.data.important is bool)
          && request.resource.data.photos is list
          && request.resource.data.photos.size() <= 5
          && (!request.resource.data.keys().hasAny([
              'replyToEntryId', 'replyToAuthorId', 'replyToAuthorName', 'replyToText'
            ])
            || (request.resource.data.replyToEntryId is string
              && request.resource.data.replyToAuthorId is string
              && request.resource.data.replyToAuthorName is string
              && request.resource.data.replyToText is string
              && get(/databases/$(database)/documents/orders/$(orderId)/entries/$(request.resource.data.replyToEntryId)).data.authorId
                == request.resource.data.replyToAuthorId));

        allow update: if (isManager() || canManageUsers() || isDirector())
          && resource.data.kind == 'defect'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['decision', 'decisionText', 'decidedBy', 'decidedByName', 'decidedAt'])
          && request.resource.data.decision in ['Подтверждён', 'Отменён', 'Удалена из заказа']
          && request.resource.data.decisionText is string

          || ((isWarehouse() || canManageUsers())
            && resource.data.kind == 'defect'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['article', 'articleIndex', 'text', 'photos'])
            && request.resource.data.article is string
            && request.resource.data.articleIndex is int
            && request.resource.data.text is string
            && request.resource.data.photos is list
            && request.resource.data.photos.size() <= 5)

          // Менеджерская группа может обновить системную запись при сохранении состава заказа.
          || (hasManagerPermissions()
            && resource.data.kind == 'system'
            && request.resource.data.kind == 'system'
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'article', 'text', 'important', 'authorName', 'createdAt', 'photos'
            ])
            && request.resource.data.text is string
            && request.resource.data.photos is list
            && request.resource.data.photos.size() <= 5);

        allow delete: if canManageUsers();
      }
    }

    match /auditLog/{auditId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'action','details','orderId','orderNumber','actorId','actorName','actorRole','createdAt',
          'entryId','previousStatus','newStatus'
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == role()
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 100
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.createdAt is string
        && (!request.resource.data.keys().hasAny(['orderId']) || request.resource.data.orderId is string && request.resource.data.orderId.size() <= 128)
        && (!request.resource.data.keys().hasAny(['orderNumber']) || request.resource.data.orderNumber is string && request.resource.data.orderNumber.size() <= 120)
        && (!request.resource.data.keys().hasAny(['entryId']) || request.resource.data.entryId is string && request.resource.data.entryId.size() <= 128)
        && (!request.resource.data.keys().hasAny(['previousStatus']) || request.resource.data.previousStatus is string && request.resource.data.previousStatus.size() <= 100)
        && (!request.resource.data.keys().hasAny(['newStatus']) || request.resource.data.newStatus is string && request.resource.data.newStatus.size() <= 100);
      allow update, delete: if false;
    }

    match /buybackItems/{itemId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['article','name','quantity','receivedAt','supplier','comment','createdAt','createdOn','createdBy','createdByName','status','soldAt','cancelledAt','returnedAt','sentMilestones','updatedAt'])
        && request.resource.data.article is string
        && request.resource.data.article.size() > 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1
        && request.resource.data.receivedAt is string
        && (!request.resource.data.keys().hasAny(['supplier']) || request.resource.data.supplier is string && request.resource.data.supplier.size() <= 160)
        && (!request.resource.data.keys().hasAny(['name']) || request.resource.data.name is string && request.resource.data.name.size() <= 300)
        && (!request.resource.data.keys().hasAny(['comment']) || request.resource.data.comment is string && request.resource.data.comment.size() <= 1000)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.status in ['active','returned','sold','cancelled','expired']
        && request.resource.data.sentMilestones is list;
      allow update: if activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['article','name','quantity','receivedAt','supplier','comment','status','soldAt','cancelledAt','returnedAt','sentMilestones','updatedAt'])
        && request.resource.data.article is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1
        && request.resource.data.receivedAt is string
        && (!request.resource.data.keys().hasAny(['supplier']) || request.resource.data.supplier is string && request.resource.data.supplier.size() <= 160)
        && (!request.resource.data.keys().hasAny(['name']) || request.resource.data.name is string && request.resource.data.name.size() <= 300)
        && (!request.resource.data.keys().hasAny(['comment']) || request.resource.data.comment is string && request.resource.data.comment.size() <= 1000)
        && request.resource.data.status in ['active','returned','sold','cancelled','expired']
        && request.resource.data.sentMilestones is list;
      allow delete: if canManageUsers();
    }

    match /shipmentDays/{dateKey} {
      allow read: if activeUser();

      // Отметки проверки отгрузки хранятся отдельно от заказов.
      // Они не меняют статус заказа и доступны только кладовщику/администратору.
      allow create: if (isWarehouse() || canManageUsers())
        && request.resource.data.keys().hasOnly(['date','checkedArticles','checkedOrderArticles'])
        && request.resource.data.date == dateKey
        && ((!request.resource.data.keys().hasAny(['checkedArticles'])) || request.resource.data.checkedArticles is list)
        && ((!request.resource.data.keys().hasAny(['checkedOrderArticles'])) || request.resource.data.checkedOrderArticles is list);

      allow update: if (isWarehouse() || canManageUsers())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedArticles','checkedOrderArticles'])
        && request.resource.data.date == dateKey
        && ((!request.resource.data.keys().hasAny(['checkedArticles'])) || request.resource.data.checkedArticles is list)
        && ((!request.resource.data.keys().hasAny(['checkedOrderArticles'])) || request.resource.data.checkedOrderArticles is list);

      // Подтвердить список могут кладовщик, менеджер и администратор.
      allow create: if (isWarehouse() || isManager() || canManageUsers())
        && request.resource.data.keys().hasOnly([
          'date','confirmed','confirmedBy','confirmedByName','confirmedAt','orderCount','itemCount',
          'revokedBy','revokedByName','revokedAt','checkedArticles'
        ])
        && request.resource.data.date == dateKey
        && request.resource.data.confirmed == true
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.confirmedByName is string
        && request.resource.data.confirmedAt is string
        && request.resource.data.orderCount is number
        && request.resource.data.itemCount is number
        && (!request.resource.data.keys().hasAny(['checkedArticles']) || request.resource.data.checkedArticles is list);

      // Снять подтверждение может только кладовщик или администратор.
      allow update: if (isWarehouse() || canManageUsers())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'confirmed','confirmedBy','confirmedByName','confirmedAt','orderCount','itemCount',
          'revokedBy','revokedByName','revokedAt'
        ])
        && request.resource.data.date == dateKey
        && request.resource.data.confirmed == false
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedByName is string
        && request.resource.data.revokedAt is string
        && request.resource.data.orderCount is number
        && request.resource.data.itemCount is number;

      // Повторно подтвердить существующий список.
      allow update: if (isWarehouse() || isManager() || canManageUsers())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'confirmed','confirmedBy','confirmedByName','confirmedAt','orderCount','itemCount',
          'revokedBy','revokedByName','revokedAt'
        ])
        && request.resource.data.date == dateKey
        && request.resource.data.confirmed == true
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.confirmedByName is string
        && request.resource.data.confirmedAt is string
        && request.resource.data.orderCount is number
        && request.resource.data.itemCount is number;
      
      allow delete: if canManageUsers();
    }
  }
}
