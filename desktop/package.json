{
  "name": "warehouse-orders-desktop",
  "version": "1.0.0",
  "description": "Windows desktop app for Warehouse Orders",
  "main": "main.cjs",
  "author": "AMP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "ua.amp.warehouseorders",
    "productName": "Заказы · Склад",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Warehouse-Orders-Setup-${version}.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Заказы · Склад"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hlebish",
        "repo": "warehouse_orders",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
