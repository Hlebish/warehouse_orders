rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeUser() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function isDirector() {
      return activeUser()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    match /chat/{userId}/{fileName} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.auth.uid == userId
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if activeUser() && request.auth.uid == userId;
    }

    // Personal chat attachments are separate from the shared staff chat.
    match /directChats/{threadId}/{userId}/{messageId}/{fileName} {
      function participant() {
        return activeUser()
          && request.auth.uid in firestore.get(/databases/(default)/documents/directChats/$(threadId)).data.participants;
      }
      allow read: if participant();
      allow create: if participant()
        && resource == null
        && request.auth.uid == userId
        && fileName.matches('[0-4]\\.jpg')
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if participant() && request.auth.uid == userId;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && request.auth.uid == userId
        && fileName == 'profile.jpg'
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if activeUser() && request.auth.uid == userId && fileName == 'profile.jpg';
    }

    match /orders/{orderId}/{entryId}/{fileName} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isDirector();
    }
  }
}
